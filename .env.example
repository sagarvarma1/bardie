# "console" = chat in your terminal (no Photon needed), "photon" = real iMessage
TRANSPORT=console

# Photon (app.photon.codes): `photon projects show` prints both
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Claude API key from console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Voice memo transcription, from console.deepgram.com -> API Keys (optional)
DEEPGRAM_API_KEY=

# Google OAuth client from console.cloud.google.com (see SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who can connect Google, matching Google's review of the OAuth app:
#   testers = before any review: only the phones below (their Gmail must also be a
#             test user in Google Cloud > Audience). Everyone else: "coming soon".
#   basic   = sensitive scopes approved: calendar, contacts, sending email, for everyone
#   full    = Gmail review (CASA) passed: also reading and cleaning up the inbox
GOOGLE_ACCESS=testers
GOOGLE_TESTER_PHONES=

# Encrypts Google tokens at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

APP_NAME=Bardie
SUPPORT_EMAIL=support@textbardie.com

# Dedicated iMessage number anyone can text (Photon Business line, +1...).
# Set it and the website becomes a one-tap "Text Bardie" button. Leave empty on the free tier.
BARDIE_NUMBER=

# The website. Google redirects back to PUBLIC_URL/oauth/google/callback,
# so it must match what you registered in Google Cloud.
PORT=3000
PUBLIC_URL=http://localhost:3000

# Where the SQLite database lives. On Railway, point it at the volume: /data/app.db
DATABASE_PATH=data/app.db

# Signup cap (Photon Free = 10 users, Pro = 100). Past it, signups go on a waitlist: npm run waitlist
MAX_USERS=10

# Texts per user per day before Bardie rests until tomorrow (keeps the Claude bill in check)
DAILY_MESSAGE_LIMIT=100

# Used only when a user's timezone is unknown (the signup page reads it from their phone)
DEFAULT_TIMEZONE=America/Los_Angeles
MONITOR_INTERVAL_SECONDS=60

# Console mode only: the phone number your terminal messages come from
CONSOLE_PHONE=+15555550100
